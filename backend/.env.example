# Шаблон переменных окружения для всех трёх систем. Скопировать и заполнить:
#     cp .env.example .env
#
# Единственная точка чтения — backend/config.py (pydantic Settings). Файл
# подхватывается сам при импорте, поэтому --env-file не нужен.
#
# .env в .gitignore — настоящие ключи в репозиторий не попадают.

# Serper.dev — выдача Google для probe.serp. $1 за 1 000 запросов.
# Ключ: https://serper.dev → Dashboard → API Key
SERPER_API_KEY=

# OpenRouter — классификация и why_now (Ф9), смысл подписей инстаграма (Ф6)
# и черновики переписки системы 2.
# Ключ: https://openrouter.ai/keys
#
# Модель задаётся в collector/config.toml [llm] и writer/config.toml [llm],
# а не здесь: имя модели входит в ключ кэша ответов collector'а, и менять его
# надо там же, где видно последствие.
OPENROUTER_API_KEY=

# Langfuse — трейсинг вызовов LLM (self-host на VPS). Без ключей трейсинг
# молча выключен, LLM-вызовы работают как обычно.
# Ключи: Langfuse UI -> Settings -> API Keys, проект уже создан на VPS.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://109.199.125.111:3000

# Общий секрет вебхука: Python сверяет заголовок X-Sender-Secret, Node шлёт его
# из той же переменной. Пустое значение выключает проверку — так работает
# локальная разработка, где Node и Python говорят через 127.0.0.1.
SENDER_WEBHOOK_SECRET=

# Песочница аутрича. Включённая, она подменяет транспорт и базу целиком:
# SENDER_NODE_URL обязан указывать на подменный Node, иначе бэкенд не стартует.
SANDBOX=0
# SENDER_NODE_URL=http://127.0.0.1:8787/api/sandbox/node
