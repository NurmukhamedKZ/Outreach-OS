# Шаблон переменных окружения для всех трёх систем. Скопировать и заполнить:
#     cp .env.example .env
#
# Единственная точка чтения — backend/config.py (pydantic Settings). Файл
# подхватывается сам при импорте, поэтому --env-file не нужен.
#
# .env в .gitignore — настоящие ключи в репозиторий не попадают.

# Serper.dev — выдача Google для probe.serp. $1 за 1 000 запросов.
# Ключ: https://serper.dev → Dashboard → API Key
SERPER_API_KEY=

# OpenRouter — классификация и why_now (Ф9), смысл подписей инстаграма (Ф6)
# и черновики переписки системы 2.
# Ключ: https://openrouter.ai/keys
#
# Модель задаётся в collector/config.toml [llm] и writer/config.toml [llm],
# а не здесь: имя модели входит в ключ кэша ответов collector'а, и менять его
# надо там же, где видно последствие.
OPENROUTER_API_KEY=
