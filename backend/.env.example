# Шаблон переменных окружения для всех трёх систем. Скопировать и заполнить:
#     cp .env.example .env
#
# Единственная точка чтения — backend/config.py (pydantic Settings). Файл
# подхватывается сам при импорте, поэтому --env-file не нужен.
#
# .env в .gitignore — настоящие ключи в репозиторий не попадают.

# OpenRouter — исследование компаний (досье и зацепки) и черновики переписки.
# Ключ: https://openrouter.ai/keys
#
# Модель исследования — на странице «Настройки», модель черновиков —
# writer/config.toml [llm], а не здесь.
OPENROUTER_API_KEY=

# Langfuse — трейсинг вызовов LLM (self-host на VPS). Без ключей трейсинг
# молча выключен, LLM-вызовы работают как обычно.
# Ключи: Langfuse UI -> Settings -> API Keys, проект уже создан на VPS.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://109.199.125.111:3000

# Общий секрет вебхука: Python сверяет заголовок X-Sender-Secret, Node шлёт его
# из той же переменной. Пустое значение выключает проверку — так работает
# локальная разработка, где Node и Python говорят через 127.0.0.1.
SENDER_WEBHOOK_SECRET=

# Песочница аутрича. Включённая, она подменяет транспорт и базу целиком:
# SENDER_NODE_URL обязан указывать на подменный Node, иначе бэкенд не стартует.
SANDBOX=0
# SENDER_NODE_URL=http://127.0.0.1:8787/api/sandbox/node
# Песочница проверяет и порт: SENDER_NODE_URL и SANDBOX_SELF_URL обязаны вести на
# UVICORN_PORT этого бэкенда.

# Офлайн-режим (#52): модель отвечает без сети и без денег, страницы берутся только
# из сохранённых в DATA_DIR/pages. Текст выдуманный, поэтому бэкенд стартует с ним
# только при SANDBOX=1 и на каталоге данных стенда (в пути DATA_DIR есть .stand).
# Включает его только стенд (scripts/stand; --online — без него). В бою не задавать.
# OFFLINE=0

# Порт бэкенда и каталог данных. Задаёт их стенд (scripts/stand) — свои на каждый
# worktree. В бою не задавать: пустой DATA_DIR — это пустая база, отказы тоже.
# UVICORN_PORT=8787
# DATA_DIR=

# Бэкап невосстановимого слоя (#8). По умолчанию — папка в iCloud Drive:
# ~/Library/Mobile Documents/com~apple~CloudDocs/Outreach-OS-backup.
# Нет родительской папки — бэкап выключен (видно на «Процессах»).
# BACKUP_DIR=
