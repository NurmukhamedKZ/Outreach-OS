# Шаблон переменных окружения. Скопировать и заполнить:
#     cp .env.example .env
#
# Подхват при запуске:
#     uv run --env-file .env serp.py "директор ТОО Ромашка"
# Либо один раз на сессию, тогда обычный `uv run` тоже увидит .env:
#     export UV_ENV_FILE=.env
#
# .env в .gitignore — настоящие ключи в репозиторий не попадают.

# Serper.dev — выдача Google для serp.py. $1 за 1 000 запросов.
# Ключ: https://serper.dev → Dashboard → API Key
SERPER_API_KEY=

# OpenRouter — классификация и why_now (Ф9) и смысл подписей инстаграма (Ф6).
# Ключ: https://openrouter.ai/keys
#
# Модель задаётся в config.toml [llm].model, а не здесь: имя модели входит в ключ
# кэша ответов, и менять его надо там же, где видно последствие.
# Сейчас deepseek/deepseek-v4-flash — $0.061 за 1M входных токенов, то есть весь
# инстаграм на 288 аккаунтов стоит около пяти центов, разово.
#
# Какие модели доступны: uv run --env-file .env -m scripts.classify --models deepseek
OPENROUTER_API_KEY=
