# Контекст сборки бэкенда — корень репозитория (api.py монтирует writer/ рядом с
# собой). Тяжёлое и невосстановимое сюда не идёт — оно приезжает volume'ами.
.git
.claude
.playwright-mcp
plans
docs

**/.venv
**/node_modules
**/__pycache__
**/*.py[oc]
**/.env

