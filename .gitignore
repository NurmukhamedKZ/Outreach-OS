# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Instagram-сессия и выгрузки
backend/collector/data/cookies.json
backend/collector/data/ig_profile/
backend/collector/data/leads.csv
*_posts.json

# Слой сырья: невосстановим, в git не кладётся — бэкапится отдельно
backend/collector/data/raw/*
!backend/collector/data/raw/.gitkeep

# Производные JSONL. НЕ удалены в Ф3: 60 организаций рубрики 1236, 14 карточек
# филиалов и 135 рубрик собраны, когда их HTML ещё не сохранялся, — build.py их
# не воспроизводит. Удалять можно после того, как Ф4 доберёт сырьё.
backend/collector/data/raw_jsonl_legacy/

# Производное: пересобирается прогонами из raw/, в git не кладётся
backend/collector/data/derived.db
backend/collector/data/derived.db-wal
backend/collector/data/derived.db-shm

# Порождённое: невосстановимо (как raw/), бэкапится отдельно
backend/collector/data/state.db
backend/collector/data/state.db-wal
backend/collector/data/state.db-shm

# Устаревшие пути (удаляются при миграции)
backend/collector/db/leads.db
backend/collector/db/ops.db
backend/writer/threads.db

# Ключи. Шаблон — в .env.example
.env

# Файловые логи бэкенда
backend/logs/

# Веб: зависимости и сборка Next ставятся из package-lock.json
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts

# Сессии WhatsApp: ключи к живым номерам, в git не кладутся ни при каком
# способе добавления файлов (дублируется в sender/node/.gitignore)
backend/sender/node/sessions/

# Отладка браузером
.playwright-mcp/

.DS_Store

# Режим автопилота — состояние машины, а не конфигурация проекта: на боевом
# сервере он «full», в репозитории его быть не должно вовсе.
backend/sender/autopilot
backend/sender/autopilot.tmp
